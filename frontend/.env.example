# Frontend env. Copy to `.env.development` for local dev.
# Vite only exposes variables prefixed with VITE_ to client code.
#
# Local dev (Vite on 5173 + uvicorn on 8765 separately):
#   VITE_API_URL=http://localhost:8765/api
#
# Unified prod build (FastAPI serves static files + API on one port):
#   leave unset — api.ts defaults to "./api" so URLs resolve relative to
#   the document, making the deploy prefix-agnostic.
VITE_API_URL=http://localhost:8765/api
