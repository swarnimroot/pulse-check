# pulse-check environment configuration
# Copy to `.env` and fill in the values for your local setup.
# `.env` is gitignored; never commit real credentials.

# --- Anthropic (Sonnet + Haiku) ---------------------------------------------
# Required. Used for gold-set labeling, addressability classification,
# verbatim selection, and brief writing. Haiku handles near-duplicate dedup.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Anthropic model IDs. Defaults are usable; override for version pinning.
ANTHROPIC_SONNET_MODEL=claude-sonnet-4-6
ANTHROPIC_HAIKU_MODEL=claude-haiku-4-5-20251001

# --- Ollama (local Qwen) ----------------------------------------------------
# Required. Ollama must be running locally with the model pulled.
# Default host matches Ollama's standard install.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-q4_K_M

# --- Storage ----------------------------------------------------------------
# SQLite URL (v1 default). Swap to postgresql://... for future cloud migration.
DATABASE_URL=sqlite:///data/pulse_check.db

# scrapers-lib HTTP/render cache directory. Separate from the analysis DB.
SCRAPE_CACHE_DIR=data/scrape_cache

# scrapers-lib Scheduler state (resumable scrape queue).
SCHEDULER_DB_PATH=data/scheduler_state.db

# Playwright persistent profiles (Tier 2/3 sources).
PLAYWRIGHT_PROFILE_DIR=data/playwright_profiles

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=data/pulse_check.log

# --- FastAPI backend --------------------------------------------------------
# Single port serves both API (/api/*) and the built frontend (/) in unified
# prod mode. CORS origins only matter when running the Vite dev server (5173)
# separately. Origins must be a JSON list (pydantic-settings parses it).
API_HOST=127.0.0.1
API_PORT=8765
API_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
